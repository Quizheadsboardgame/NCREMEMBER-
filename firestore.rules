rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(cat) {
      return cat == 'NC' || cat == 'EX' || cat == 'ME';
    }

    function isValidTask(data, userId) {
      return data.id is string && isValidId(data.id) &&
             data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             isValidCategory(data.category) &&
             data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.hasTime is bool &&
             (!('dueTime' in data) || (data.dueTime is string && (data.dueTime.size() == 0 || (data.dueTime.size() == 5 && data.dueTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))))) &&
             data.completed is bool &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 100)) &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // User profile document
    match /users/{userId}/profile {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // User tasks collection
    match /users/{userId}/tasks/{taskId} {
      allow list: if isOwner(userId) && isValidId(userId);
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(taskId) &&
                    incoming().id == taskId &&
                    isValidTask(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(taskId) &&
                    incoming().id == taskId &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    isValidTask(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
    }
  }
}
